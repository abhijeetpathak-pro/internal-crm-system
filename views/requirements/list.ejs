<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head',{title:'Requirements — CWA CRM'}) %>
    <style>
      .table-wrap {
        overflow: visible !important;
      }

      .req-table th,
      .req-table td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .req-table .col-id {
        max-width: 70px;
        min-width: 60px;
      }

      .req-table .col-title {
        max-width: 200px;
        min-width: 140px;
      }

      .req-table .col-client {
        max-width: 120px;
        min-width: 80px;
      }

      .req-table .col-location {
        max-width: 110px;
        min-width: 80px;
      }

      .req-table .col-status {
        max-width: 85px;
        min-width: 65px;
      }

      .req-table .col-budget {
        max-width: 90px;
        min-width: 65px;
      }

      .req-table .col-submitted {
        max-width: 110px;
        min-width: 80px;
      }

      .req-table .col-profile {
        max-width: 150px;
        min-width: 120px;
      }

      .req-table td .ellipsis {
        display: inline-block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
      }

      .action-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 50%;
        border: 1px solid #dee2e6;
        background: #fff;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        color: #6B7280;
        transition: all 0.15s;
        cursor: pointer;
      }

      .action-btn:hover {
        background: #f3f4f6;
        border-color: #C0392B;
        color: #C0392B;
      }

      .cwa-isolated-menu-list {
        display: none;
        position: absolute;
        right: 10px;
        top: 38px;
        background: #ffffff;
        min-width: 180px;
        z-index: 999999 !important;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 6px 0 !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        list-style: none !important;
        margin: 0 !important;
      }

      .cwa-isolated-menu-list li {
        list-style: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .cwa-isolated-menu-list .dropdown-item {
        font-size: 0.85rem;
        padding: 0.5rem 1rem;
        display: flex;
        align-items: center;
        color: #374151;
        text-decoration: none;
        cursor: pointer;
        gap: 8px;
      }

      .cwa-isolated-menu-list .dropdown-item:hover {
        background: #f8f9fa;
        color: #1a1a1a;
      }

      .cwa-isolated-menu-list .dropdown-item i {
        width: 18px;
        text-align: center;
      }

      .cwa-isolated-menu-list .divider {
        border-top: 1px solid #e5e7eb;
        margin: 4px 8px;
      }

      .action-cell {
        position: relative;
        overflow: visible !important;
        text-align: center;
      }

      .action-cell .btn-wrap {
        display: inline-block;
        position: relative;
      }

      .status-badge {
        padding: 0.25rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
      }

      .status-badge.open {
        background: #dcfce7;
        color: #15803d;
      }

      .status-badge.hold {
        background: #f3f4f6;
        color: #6b7280;
      }

      .profile-badge-shared {
        background: #dcfce7;
        color: #166534;
        padding: 0.25rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
        border: 1px solid #86efac;
      }

      .profile-badge-not-shared {
        background: #fef2f2;
        color: #b91c1c;
        padding: 0.25rem 0.6rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
        border: 1px solid #fca5a5;
      }

      #resultCount {
        font-size: 0.75rem;
        padding: 0.25rem 0.6rem;
      }
    </style>
</head>

<body>
  <%- include('../partials/sidebar',{user,active}) %>
    <div class="main-content">
      <%- include('../partials/topbar',{user}) %>
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="fw-semibold mb-0"><i class="fa-solid fa-clipboard-list me-2 text-danger"></i>Requirements</h4>
          <a href="/requirements/add" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>Add
            Requirement</a>
        </div>

        <!-- Share / Not Shared Filter Dropdown -->
        <div class="d-flex align-items-center gap-2 mb-3">
          <select id="requirementShareFilter" class="form-select form-select-sm w-auto" onchange="filterRequirements()">
            <option value="all">All Requirements (Normal)</option>
            <option value="shared">Shared</option>
            <option value="not_shared">Not Shared</option>
          </select>
          <button class="btn btn-sm btn-outline-secondary" onclick="resetShareFilter()">Reset</button>
        </div>

        <div class="mb-3 d-flex align-items-center">
          <div class="input-group input-group-sm" style="max-width:350px">
            <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-danger"
                style="font-size:.8rem"></i></span>
            <input type="text" id="reqSearchInput" class="form-control"
              placeholder="Search by title, client, location..." onkeyup="filterRequirements()">
            <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()"><i
                class="fa-solid fa-times"></i></button>
          </div>
          <span class="badge bg-secondary ms-2" id="resultCount">0 results</span>
        </div>

        <% if(!groups || !groups.length){ %>
          <div class="card stat-card p-0">
            <div class="text-center py-4 text-secondary">No requirements yet.</div>
          </div>
          <% } %>

            <div id="reqGroups">
              <% if(groups && groups.length){ %>
                <% groups.forEach(function(group){ %>
                  <div class="mb-3 req-group" data-group-key="<%= group.key %>">
                    <div class="fw-semibold small text-uppercase text-secondary mb-2">
                      <i class="fa-solid fa-calendar-day me-2"></i>
                      <%= group.label %>
                        <span class="badge bg-secondary ms-1">
                          <%= group.requirements ? group.requirements.length : 0 %>
                        </span>
                    </div>
                    <div class="card stat-card p-0">
                      <div class="table-wrap">
                        <table class="table align-middle mb-0 req-table">
                          <thead>
                            <tr class="text-secondary small text-uppercase border-bottom">
                              <th class="col-id ps-3">ID</th>
                              <th class="col-title">Title</th>
                              <th class="col-client">Client</th>
                              <th class="col-location">Location</th>
                              <th class="col-status">Status</th>
                              <th class="col-budget">Budget</th>
                              <th class="col-submitted">Submitted By</th>
                              <th class="col-profile">Profile / Stages</th>
                              <th class="text-center" style="width:100px">Action</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if(group.requirements && group.requirements.length){ %>
                              <% group.requirements.forEach(function(r){ %>
                                <tr id="rrow-<%= r.id %>" class="req-row"
                                  data-share-status="<%= r.is_shared == 1 ? 'shared' : 'not_shared' %>"
                                  data-search="<%= [r.id, r.title, r.company_name, r.location, r.status, r.budget, r.submitted_by_name].filter(Boolean).join(' ').toLowerCase() %>">

                                  <!-- Separate ID Column -->
                                  <td class="col-id ps-3">
                                    <span class="badge bg-primary" style="font-size: 0.7rem;">#<%= r.id %></span>
                                  </td>

                                  <!-- Clean Title Column (ID removed from here) -->
                                  <td class="col-title">
                                    <a href="/requirements/<%= r.id %>" class="fw-semibold text-decoration-none"
                                      style="color:#1A1A1A"><span class="ellipsis">
                                        <%= r.title %>
                                      </span></a>
                                  </td>

                                  <td class="col-client small text-secondary"><span class="ellipsis">
                                      <%= r.company_name||'—' %>
                                    </span></td>
                                  <td class="col-location small text-secondary"><span class="ellipsis">
                                      <%= r.location || '—' %>
                                    </span></td>
                                  <td class="col-status"><span
                                      class="status-badge <%= r.status === 'Hold' ? 'hold' : 'open' %>">
                                      <%= r.status || 'Open' %>
                                    </span></td>
                                  <td class="col-budget small text-secondary"><span class="ellipsis">
                                      <%= r.budget||'—' %>
                                    </span></td>
                                  <td class="col-submitted small text-secondary"><span class="ellipsis">
                                      <%= r.submitted_by_name || '—' %>
                                    </span></td>

                                  <td class="col-profile">
                                    <% if(r.is_shared==1) { %>
                                      <span class="profile-badge-shared mb-1 d-inline-block">
                                        <i class="fa-solid fa-circle-check me-1"></i>Shared
                                        <% const profileCount=(typeof r.mapped_profile_count !=='undefined' &&
                                          r.mapped_profile_count !==null) ? parseInt(r.mapped_profile_count) : 0; %>
                                          <% if(profileCount> 0) { %> (<%= profileCount %>) <% } %>
                                      </span>
                                      <% } else { %>
                                        <span class="profile-badge-not-shared mb-1 d-inline-block">
                                          <i class="fa-regular fa-circle me-1"></i>Not Shared
                                        </span>
                                        <% } %>

                                          <!-- Pipeline Stages Count Badges -->
                                          <% if (r.pipeline_stages) { %>
                                            <div class="pipeline-stages-summary mt-1" style="font-size: 0.65rem;">
                                              <span class="badge bg-secondary">SR: <%= r.pipeline_stages.SR ?
                                                  r.pipeline_stages.SR.length : 0 %></span>
                                              <span class="badge bg-info">L1: <%= r.pipeline_stages.L1 ?
                                                  r.pipeline_stages.L1.length : 0 %></span>
                                              <span class="badge bg-warning text-dark">L2: <%= r.pipeline_stages.L2 ?
                                                  r.pipeline_stages.L2.length : 0 %></span>
                                              <span class="badge bg-success">Sel: <%= r.pipeline_stages.Select ?
                                                  r.pipeline_stages.Select.length : 0 %></span>
                                            </div>

                                            <!-- Names List -->
                                            <div class="stages-person-list mt-1 text-muted"
                                              style="font-size: 0.7rem; white-space: normal; line-height: 1.2;">
                                              <% ['SR', 'L1' , 'L2' , 'Select' ].forEach(stageName=> { %>
                                                <% if (r.pipeline_stages[stageName] &&
                                                  r.pipeline_stages[stageName].length> 0) { %>
                                                  <div><strong>
                                                      <%= stageName %>:
                                                    </strong>
                                                    <%= r.pipeline_stages[stageName].map(p=> p.resource_name).join(', ')
                                                      %>
                                                  </div>
                                                  <% } %>
                                                    <% }) %>
                                            </div>
                                            <% } %>
                                  </td>

                                  <td class="action-cell">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                      <!-- WhatsApp Share Button -->
                                      <button type="button" class="action-btn share-whatsapp-btn"
                                        data-id="<%= r.id ? String(r.id).replace(/" /g,'"') : '' %>"
                                        data-title="<%= r.title ? String(r.title).replace(/"/g,'"') : '' %>"
                                          data-location="<%= r.location ? r.location.replace(/"/g, '"' ) : '' %>"
                                            data-budget="<%= r.budget ? r.budget.replace(/"/g, '"' ) : '' %>"
                                              data-status="<%= r.status ? r.status.replace(/"/g, '"' ) : '' %>"
                                                data-jd="<%= r.jd ? encodeURIComponent(r.jd) : '' %>"title="Share on
                                                  WhatsApp">
                                                  <i class="fa-brands fa-whatsapp fs-6"></i>
                                      </button>

                                      <!-- Menu Options Dropdown -->
                                      <div class="btn-wrap">
                                        <button class="action-btn menu-trigger-btn" type="button"
                                          data-id="<%= r.id %>"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                        <ul id="menu-box-<%= r.id %>" class="cwa-isolated-menu-list">
                                          <li><a class="dropdown-item" href="/requirements/<%= r.id %>"><i
                                                class="fa-solid fa-eye text-secondary"></i>View</a></li>
                                          <li><a class="dropdown-item" href="#"
                                              onclick="openEditModal('<%= r.id %>'); return false;"><i
                                                class="fa-solid fa-pencil text-primary"></i>Edit</a></li>
                                          <li class="divider"></li>
                                          <li><a class="dropdown-item text-danger delete-btn-trigger" href="#"
                                              data-id="<%= r.id %>"><i class="fa-solid fa-trash"></i>Delete</a></li>
                                        </ul>
                                      </div>
                                    </div>
                                  </td>
                                </tr>
                                <% }) %>
                                  <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                  <% }) %>
                    <% } %>
            </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
          <div class="modal-header border-0">
            <h5 class="modal-title fw-semibold">Edit Requirement</h5>
            <button class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" id="editModalBody">
            <div class="text-center py-4">
              <div class="spinner-border spinner-border-sm text-danger"></div> Loading...
            </div>
          </div>
          <div class="modal-footer border-0">
            <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button class="btn btn-primary btn-sm" onclick="submitEdit()">Save Changes</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
          <div class="modal-header border-0">
            <h6 class="modal-title fw-semibold"><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>Confirm
              Delete</h6>
            <button class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p class="small mb-0">Are you sure you want to delete <strong id="deleteName"></strong>?</p>
            <p class="small text-secondary mb-0">This cannot be undone.</p>
          </div>
          <div class="modal-footer border-0">
            <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button class="btn btn-sm btn-danger" id="confirmDeleteBtn">Delete</button>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script>
      let editModalObj = null;
      let deleteModalObj = null;
      let deleteId = null;

      document.addEventListener('DOMContentLoaded', function () {
        editModalObj = new bootstrap.Modal(document.getElementById('editModal'));
        deleteModalObj = new bootstrap.Modal(document.getElementById('deleteModal'));
        filterRequirements();
      });

      // WhatsApp Share Event Listener (Secure data-attributes decoding)
      document.addEventListener('click', function (event) {
        const shareBtn = event.target.closest('.share-whatsapp-btn');
        if (shareBtn) {
          event.preventDefault();

          const id = shareBtn.getAttribute('data-id');
          const title = shareBtn.getAttribute('data-title');
          const company = shareBtn.getAttribute('data-company');
          const location = shareBtn.getAttribute('data-location');
          const budget = shareBtn.getAttribute('data-budget');
          const status = shareBtn.getAttribute('data-status');
          const jd = decodeURIComponent(shareBtn.getAttribute('data-jd') || '');

          const text = `🚀 *New Requirement Opening*\n\n` +
            `*Job ID:* #${id}\n` +
            `*Title:* ${title}\n` +
            `*Location:* ${location || '—'}\n` +
            `*Budget:* ${budget || '—'}\n` +
            `*Status:* ${status || 'Open'}\n\n` +
            `📋 *Job Description:*\n${jd}`;

          window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
        }
      });

      function filterRequirements() {
        const q = document.getElementById('reqSearchInput').value.toLowerCase().trim();
        const shareStatus = document.getElementById('requirementShareFilter').value;
        let totalCount = 0;

        document.querySelectorAll('.req-group').forEach(group => {
          let visibleCount = 0;
          group.querySelectorAll('.req-row').forEach(row => {
            const rowSearch = row.dataset.search || '';
            const rowStatus = row.getAttribute('data-share-status');

            const matchesSearch = !q || rowSearch.includes(q);
            const matchesShare = (shareStatus === 'all') || (rowStatus === shareStatus);

            const show = matchesSearch && matchesShare;
            row.style.display = show ? '' : 'none';
            if (show) visibleCount++;
          });
          group.style.display = visibleCount > 0 ? '' : 'none';
          totalCount += visibleCount;
        });
        document.getElementById('resultCount').textContent = totalCount + ' results';
      }

      function clearSearch() {
        document.getElementById('reqSearchInput').value = '';
        filterRequirements();
      }

      function resetShareFilter() {
        document.getElementById('requirementShareFilter').value = 'all';
        filterRequirements();
      }

      async function openEditModal(id) {
        document.getElementById('editModalBody').innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-danger"></div> Loading data...</div>';
        editModalObj.show();

        try {
          const res = await fetch('/api/requirements/' + id);
          const data = await res.json();

          const r = data.requirement || data;
          const clients = data.clients || [];
          const pocs = data.pocs || [];

          let clientOptions = '<option value="">Select client...</option>';
          clients.forEach(c => {
            clientOptions += `<option value="${c.id}" ${r.client_id == c.id ? 'selected' : ''}>${c.company_name}</option>`;
          });

          let pocOptions = '<option value="">Select POC...</option>';
          pocs.forEach(p => {
            pocOptions += `<option value="${p.id}" ${r.poc_id == p.id ? 'selected' : ''}>${p.poc_name}</option>`;
          });

          document.getElementById('editModalBody').innerHTML = `
          <input type="hidden" id="eId" value="${r.id}">
          <div class="row g-2 mb-2">
            <div class="col-md-6">
              <label class="form-label small">Client *</label>
              <select id="eClientId" class="form-select form-select-sm">${clientOptions}</select>
            </div>
            <div class="col-md-6">
              <label class="form-label small">POC</label>
              <select id="ePocId" class="form-select form-select-sm">${pocOptions}</select>
            </div>
          </div>
          <div class="row g-2 mb-2">
            <div class="col-md-8">
              <label class="form-label small">Requirement Title *</label>
              <input type="text" id="eTitle" class="form-control form-control-sm" value="${r.title || ''}">
            </div>
            <div class="col-md-4">
              <label class="form-label small">Location</label>
              <input type="text" id="eLocation" name="r_location" class="form-control form-control-sm" placeholder="e.g. Delhi / Remote" value="${r.location || ''}">
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label small">Job Description</label>
            <textarea id="eJd" class="form-control form-control-sm" rows="3">${r.jd || ''}</textarea>
          </div>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label small">Status</label>
              <select id="eStatus" class="form-select form-select-sm">
                <option value="Open" ${r.status === 'Open' || !r.status ? 'selected' : ''}>Open</option>
                <option value="Hold" ${r.status === 'Hold' ? 'selected' : ''}>Hold</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small">Budget</label>
              <input type="text" id="eBudget" class="form-control form-control-sm" value="${r.budget || ''}">
            </div>
          </div>
          <div id="editMsg" class="alert mt-2 d-none py-1 small"></div>
        `;
        } catch (err) {
          document.getElementById('editModalBody').innerHTML = '<div class="alert alert-danger">Error fetching details.</div>';
        }
      }

      async function submitEdit() {
        const id = document.getElementById('eId').value;
        const msg = document.getElementById('editMsg');

        const payload = {
          title: document.getElementById('eTitle').value,
          client_id: document.getElementById('eClientId').value,
          poc_id: document.getElementById('ePocId').value,
          location: document.getElementById('eLocation').value,
          r_location: document.getElementById('eLocation').value,
          jd: document.getElementById('eJd').value,
          status: document.getElementById('eStatus').value,
          budget: document.getElementById('eBudget').value
        };

        try {
          const res = await fetch('/api/requirements/' + id, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (res.ok) {
            location.reload();
          } else {
            const data = await res.json();
            msg.className = 'alert alert-danger mt-2 py-1 small';
            msg.textContent = data.error || 'Failed to update requirement.';
            msg.classList.remove('d-none');
          }
        } catch (err) {
          msg.className = 'alert alert-danger mt-2 py-1 small';
          msg.textContent = 'Error: ' + err.message;
          msg.classList.remove('d-none');
        }
      }

      function delReq(id) {
        deleteId = id;
        const row = document.getElementById('rrow-' + id);
        const name = row ? row.querySelector('.col-title .ellipsis')?.textContent.trim() : 'this requirement';
        document.getElementById('deleteName').textContent = name;
        if (deleteModalObj) deleteModalObj.show();
      }

      document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
        if (!deleteId) return;
        try {
          const res = await fetch('/api/requirements/' + deleteId, { method: 'DELETE' });
          if (res.ok) {
            const row = document.getElementById('rrow-' + deleteId);
            if (row) row.remove();
            filterRequirements();
            if (deleteModalObj) deleteModalObj.hide();
          } else {
            alert('Failed to delete requirement.');
          }
        } catch (err) {
          alert('Error: ' + err.message);
        }
      });

      document.addEventListener('click', function (event) {
        const deleteBtn = event.target.closest('.delete-btn-trigger');
        if (deleteBtn) {
          event.preventDefault();
          event.stopPropagation();
          document.querySelectorAll('.cwa-isolated-menu-list').forEach(el => el.style.display = 'none');
          delReq(deleteBtn.getAttribute('data-id'));
          return;
        }

        const btn = event.target.closest('.menu-trigger-btn');
        if (btn) {
          event.preventDefault();
          event.stopPropagation();
          const menu = document.getElementById('menu-box-' + btn.dataset.id);
          document.querySelectorAll('.cwa-isolated-menu-list').forEach(m => {
            if (m !== menu) m.style.display = 'none';
          });
          if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        } else {
          document.querySelectorAll('.cwa-isolated-menu-list').forEach(m => m.style.display = 'none');
        }
      });
    </script>
</body>

</html>