<!DOCTYPE html><html lang="en"><head><%- include('partials/head',{title:'Dashboard — CWA CRM'}) %></head>
<body>
<%- include('partials/sidebar',{user,active}) %>
<div class="main-content">
  <%- include('partials/topbar',{user,showSearch:true}) %>
  <h4 class="fw-semibold mb-4">Welcome back, <%= user.name %> 👋</h4>

  <div class="row g-3 mb-4" id="statCards"><div class="col-12"><div class="text-secondary small">Loading stats...</div></div></div>

  <div class="row g-3 mb-3">
    <div class="col-lg-8"><div class="card stat-card p-3 h-100"><div class="fw-semibold mb-2">Requirements — last 30 days</div><canvas id="reqChart"></canvas></div></div>
    <div class="col-lg-4"><div class="card stat-card p-3 h-100"><div class="fw-semibold mb-2">This Month Breakdown</div><canvas id="bdChart"></canvas><div id="bdLeg" class="d-flex flex-column gap-1 mt-2 small"></div></div></div>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-lg-6"><div class="card stat-card p-3 h-100"><div class="fw-semibold mb-2">Leads — last 7 days</div><canvas id="leadsChart"></canvas></div></div>
    <div class="col-lg-6"><div class="card stat-card p-3 h-100"><div class="fw-semibold mb-2">Resource Split</div><canvas id="splitChart" style="max-height:200px"></canvas><div id="splitLeg" class="d-flex gap-3 justify-content-center mt-2 small"></div></div></div>
  </div>

  <div class="card stat-card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="fw-semibold">Recent Requirements</span>
      <a href="/requirements" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <table class="table table-sm align-middle mb-0">
      <thead><tr class="text-secondary small text-uppercase"><th>Title</th><th>Client</th><th>Status</th><th>Budget</th><th>Added</th></tr></thead>
      <tbody id="recentReqs"><tr><td colspan="5" class="text-center text-secondary py-3">Loading...</td></tr></tbody>
    </table>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.3/chart.umd.min.js"></script>
<script>
(async()=>{
  const RED='#C0392B',GREEN='#22c55e',YELLOW='#f59e0b',TEAL='#14b8a6',PURPLE='#a855f7';
  let stats;
  try {
    const statsRes = await fetch('/api/dashboard/stats');
    if (!statsRes.ok) throw new Error('Stats request failed with status ' + statsRes.status);
    stats = await statsRes.json();
  } catch(e) {
    console.error('Dashboard stats failed to load:', e);
    document.getElementById('statCards').innerHTML = '<div class="col-12"><div class="text-danger small">Could not load dashboard stats. Please refresh the page.</div></div>';
    return;
  }
  const {cards,charts}=stats;

  const cardDefs=[
    {label:'Requirements Today',value:cards.reqToday,icon:'fa-clipboard-list',bg:'#fdf2f2',color:RED},
    {label:'Requirements (Month)',value:cards.reqMonth,icon:'fa-calendar-check',bg:'#dbeafe',color:'#2563eb'},
    {label:'Profiles Sent (Today)',value:cards.profilesToday,icon:'fa-paper-plane',bg:'#fef9c3',color:'#ca8a04'},
    {label:'Profiles Sent (Month)',value:cards.profilesMonth,icon:'fa-paper-plane',bg:'#dcfce7',color:'#16a34a'},
    {label:'Leads (Month)',value:cards.leadsMonth,icon:'fa-bullseye',bg:'#fef9c3',color:'#ca8a04'},
    {label:'Total Resources',value:cards.resourcesTotal,icon:'fa-user-tie',bg:'#ffe4e6',color:'#e11d48'},
    {label:'Total Clients',value:cards.clientsTotal,icon:'fa-briefcase',bg:'#f3e8ff',color:'#9333ea'},
    {label:'Total Vendors',value:cards.vendorsTotal,icon:'fa-handshake',bg:'#fff7ed',color:'#ea580c'},
    {label:'Open Requirements',value:cards.openReqs,icon:'fa-folder-open',bg:'#f0fdf4',color:'#15803d'},
    {label:'Hold Requirements',value:cards.holdReqs,icon:'fa-pause',bg:'#f3f4f6',color:'#6b7280'},
  ];
  document.getElementById('statCards').innerHTML=cardDefs.map(c=>`
    <div class="col-xl-3 col-md-4 col-6"><div class="card stat-card p-3"><div class="d-flex align-items-center gap-3">
      <div class="stat-icon" style="background:${c.bg};color:${c.color}"><i class="fa-solid ${c.icon}"></i></div>
      <div><div class="text-secondary" style="font-size:.78rem">${c.label}</div><div class="fw-bold fs-4">${c.value}</div></div>
    </div></div></div>`).join('');

  Chart.defaults.font.family='system-ui,sans-serif';Chart.defaults.color='#6b7280';
  new Chart(document.getElementById('reqChart'),{type:'line',data:{labels:charts.reqTrend.labels,datasets:[{label:'Requirements',data:charts.reqTrend.data,borderColor:RED,backgroundColor:'rgba(192,57,43,.08)',tension:.4,fill:true,pointRadius:3}]},options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{stepSize:1}},x:{grid:{display:false}}}}});
  const bd=charts.workBreakdown;
  new Chart(document.getElementById('bdChart'),{type:'doughnut',data:{labels:['Requirements','Resources','Leads'],datasets:[{data:[bd.requirements,bd.resources,bd.leads],backgroundColor:[RED,GREEN,YELLOW],borderWidth:2,borderColor:'#fff'}]},options:{cutout:'65%',plugins:{legend:{display:false}}}});
  document.getElementById('bdLeg').innerHTML=[['Requirements',bd.requirements,RED],['Resources',bd.resources,GREEN],['Leads',bd.leads,YELLOW]].map(([l,v,c])=>`<div class="d-flex align-items-center gap-2"><span style="width:10px;height:10px;border-radius:2px;background:${c};display:inline-block"></span>${l}<strong class="ms-auto">${v}</strong></div>`).join('');
  new Chart(document.getElementById('leadsChart'),{type:'bar',data:{labels:charts.leadsTrend.labels,datasets:[{label:'Leads',data:charts.leadsTrend.data,backgroundColor:'rgba(245,158,11,.75)',borderRadius:6}]},options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{stepSize:1}},x:{grid:{display:false}}}}});
  const sp=charts.resourceSplit;
  new Chart(document.getElementById('splitChart'),{type:'pie',data:{labels:['In-House','Vendor'],datasets:[{data:[sp.inHouse,sp.vendor],backgroundColor:[TEAL,PURPLE],borderWidth:2,borderColor:'#fff'}]},options:{plugins:{legend:{display:false}}}});
  document.getElementById('splitLeg').innerHTML=[['In-House',sp.inHouse,TEAL],['Vendor',sp.vendor,PURPLE]].map(([l,v,c])=>`<div class="d-flex align-items-center gap-1"><span style="width:10px;height:10px;border-radius:50%;background:${c};display:inline-block"></span>${l}: <strong>${v}</strong></div>`).join('');

  try{const rr=await(await fetch('/api/requirements/recent')).json();
    document.getElementById('recentReqs').innerHTML=rr.length?rr.map(r=>`<tr><td><a href="/requirements/${r.id}" class="text-decoration-none fw-semibold" style="color:#1A1A1A">${r.title}</a></td><td class="text-secondary small">${r.company_name||'—'}</td><td><span class="badge" style="background:${r.status==='Hold'?'#f3f4f6':'#dcfce7'};color:${r.status==='Hold'?'#6b7280':'#15803d'}">${r.status}</span></td><td class="text-secondary small">${r.budget||'—'}</td><td class="text-secondary small">${new Date(r.created_at).toLocaleDateString('en-IN')}</td></tr>`).join(''):'<tr><td colspan="5" class="text-center text-secondary py-3">No requirements yet.</td></tr>';}catch(e){}
})();
</script>
</body></html>
