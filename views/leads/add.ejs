<!DOCTYPE html><html lang="en"><head><%- include('../partials/head',{title:'Add Lead — CWA CRM'}) %></head>
<body>
<%- include('../partials/sidebar',{user,active}) %>
<div class="main-content">
  <%- include('../partials/topbar',{user}) %>
  <h4 class="fw-semibold mb-3"><i class="fa-solid fa-plus me-2 text-danger"></i>Add Lead</h4>
  <div class="card stat-card p-4" style="max-width:480px">
    <form id="addLeadForm">
      <div class="mb-3"><label class="form-label small fw-semibold">Name *</label><input type="text" name="name" class="form-control" required></div>
      <div class="mb-3"><label class="form-label small fw-semibold">Email</label><input type="email" name="email" class="form-control"></div>
      <div class="mb-3"><label class="form-label small fw-semibold">Phone</label><input type="text" name="phone" class="form-control"></div>
      <div class="mb-3"><label class="form-label small fw-semibold">Source</label>
        <select name="source" class="form-select"><option value="Email">Email</option><option value="LinkedIn">LinkedIn</option><option value="Website">Website</option></select></div>
      <button type="submit" class="btn btn-primary">Save Lead</button>
    </form>
    <div id="msg" class="alert mt-3 d-none"></div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
<script>
document.getElementById('addLeadForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const fd=new FormData(e.target);
  const res=await fetch('/api/leads',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(fd.entries()))});
  const data=await res.json();
  const box=document.getElementById('msg');
  if(res.ok)window.location=`/leads/${data.id}`;
  else{box.classList.remove('d-none');box.classList.add('alert-danger');box.textContent=data.error||'Failed.';}
});
</script>
</body></html>
