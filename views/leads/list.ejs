<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head',{title:'Leads — CWA CRM'}) %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
  <%- include('../partials/sidebar',{user,active}) %>
  <div class="main-content">
    <%- include('../partials/topbar',{user}) %>
    
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-semibold mb-0"><i class="fa-solid fa-bullseye me-2 text-danger"></i>Leads</h4>
      <a href="/leads/add" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>Add Lead</a>
    </div>
    
    <div class="card stat-card p-0">
      <table class="table align-middle mb-0">
        <thead>
          <tr class="text-secondary small text-uppercase border-bottom">
            <th class="ps-3">Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Source</th>
            <th>Added</th>
            <th class="pe-3"></th>
          </tr>
        </thead>
        <tbody>
          <% leads.forEach(l => { %>
          <tr id="lrow-<%= l.id %>">
            <td class="ps-3 fw-semibold">
              <a href="/leads/<%= l.id %>" class="text-decoration-none" style="color:#1A1A1A"><%= l.name %></a>
            </td>
            <td class="small text-secondary"><%= l.email || '—' %></td>
            <td class="small text-secondary"><%= l.phone || '—' %></td>
            <td>
              <span class="badge rounded-pill" style="background:#fefce8;color:#854d0e"><%= l.source %></span>
            </td>
            <td class="small text-secondary"><%= new Date(l.created_at).toLocaleDateString('en-IN') %></td>
            <td class="pe-3 text-end">
              <div class="dropdown">
                <button class="btn btn-sm btn-light border rounded-circle edit-btn" 
                        style="width:32px;height:32px;padding:0" 
                        data-bs-toggle="dropdown"
                        data-lead='<%- JSON.stringify(l) %>'>
                  <i class="fa-solid fa-ellipsis-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                  <li><a class="dropdown-item" href="/leads/<%= l.id %>"><i class="fa-solid fa-eye me-2 text-secondary"></i>View</a></li>
                  <li><a class="dropdown-item edit-link" href="#"><i class="fa-solid fa-pencil me-2 text-primary"></i>Edit</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-danger" href="#" onclick="delLead(<%= l.id %>);return false"><i class="fa-solid fa-trash me-2"></i>Delete</a></li>
                </ul>
              </div>
            </td>
          </tr>
          <% }) %>
          <% if (!leads.length) { %>
          <tr>
            <td colspan="6" class="text-center py-4 text-secondary">No leads yet.</td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Edit Modal -->
  <div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0">
          <h5 class="modal-title fw-semibold">Edit Lead</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="eId">
          <div class="row g-2">
            <div class="col-12">
              <label class="form-label small">Name *</label>
              <input type="text" id="eName" class="form-control form-control-sm">
            </div>
            <div class="col-md-6">
              <label class="form-label small">Email</label>
              <input type="email" id="eEmail" class="form-control form-control-sm">
            </div>
            <div class="col-md-6">
              <label class="form-label small">Phone</label>
              <input type="text" id="ePhone" class="form-control form-control-sm">
            </div>
            <div class="col-12">
              <label class="form-label small">Source</label>
              <select id="eSource" class="form-select form-select-sm">
                <option value="Email">Email</option>
                <option value="LinkedIn">LinkedIn</option>
                <option value="Website">Website</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-primary btn-sm" onclick="submitEdit()">Save</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
  <script>
    const editModal = new bootstrap.Modal(document.getElementById('editModal'));

    // Initialize after DOM load
    document.addEventListener('DOMContentLoaded', () => {
      // Attach click handlers to Edit links
      document.querySelectorAll('.edit-link').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const btn = e.target.closest('tr').querySelector('.edit-btn');
          if (btn && btn.dataset.lead) {
            const lead = JSON.parse(btn.dataset.lead);
            editLead(lead);
          }
        });
      });
    });

    function editLead(l) {
      document.getElementById('eId').value = l.id;
      document.getElementById('eName').value = l.name || '';
      document.getElementById('eEmail').value = l.email || '';
      document.getElementById('ePhone').value = l.phone || '';
      document.getElementById('eSource').value = l.source || 'Email';
      editModal.show();
    }

    async function submitEdit() {
      const id = document.getElementById('eId').value;
      const payload = {
        name: document.getElementById('eName').value,
        email: document.getElementById('eEmail').value,
        phone: document.getElementById('ePhone').value,
        source: document.getElementById('eSource').value
      };

      try {
        const res = await fetch(`/api/leads/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          location.reload();
        } else {
          const err = await res.json().catch(() => ({}));
          alert('Failed to update: ' + (err.message || 'Unknown error'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }

    async function delLead(id) {
      if (!confirm('Delete this lead?')) return;
      try {
        const res = await fetch(`/api/leads/${id}`, { method: 'DELETE' });
        if (res.ok) {
          document.getElementById(`lrow-${id}`)?.remove();
        } else {
          alert('Failed to delete.');
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    }
  </script>
</body>
</html>