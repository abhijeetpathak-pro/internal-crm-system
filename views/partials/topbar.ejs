<div class="topbar d-flex justify-content-between align-items-center position-relative">
  <!-- Point: "Global search sirf dashboard mai hoga" — every other page
       includes this same topbar partial WITHOUT passing showSearch, so it
       defaults to hidden there. Only dashboard.ejs passes showSearch:true. -->
  <% if(typeof showSearch !== 'undefined' && showSearch){ %>
  <div style="max-width:440px;width:100%;position:relative;">
    <div class="input-group">
      <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass" style="color:#C0392B;font-size:.85rem"></i></span>
      <input type="text" id="gsi" class="form-control border-start-0" placeholder="Search resources, requirements, clients..." autocomplete="off">
    </div>
    <div id="gsr" class="position-absolute w-100 bg-white border rounded-2 shadow-sm mt-1 d-none" style="z-index:9999;max-height:380px;overflow-y:auto"></div>
  </div>
  <% }else{ %>
  <div></div>
  <% } %>
  <div class="d-flex align-items-center gap-3">
    <div class="text-end">
      <div class="fw-semibold small lh-1"><%= user.name %></div>
      <div class="text-secondary" style="font-size:.72rem;text-transform:capitalize"><%= user.role.replace('_',' ') %></div>
    </div>
    <a href="/profile" class="rounded-circle overflow-hidden" style="width:34px;height:34px;display:flex;align-items:center;justify-content:center;<%= user.avatar_path?'':'border:1px solid #ced4da' %>">
      <% if(user.avatar_path){ %>
        <img src="<%= user.avatar_path %>" style="width:100%;height:100%;object-fit:cover">
      <% }else{ %>
        <span class="btn btn-sm btn-outline-secondary rounded-circle" style="width:34px;height:34px;padding:0;display:flex;align-items:center;justify-content:center">
          <i class="fa-solid fa-user" style="font-size:.78rem"></i>
        </span>
      <% } %>
    </a>
    <a href="/logout" class="btn btn-sm rounded-circle" style="width:34px;height:34px;padding:0;display:flex;align-items:center;justify-content:center;background:#fdf2f2;color:#C0392B;border:1px solid #fca5a5" title="Logout">
      <i class="fa-solid fa-right-from-bracket" style="font-size:.78rem"></i>
    </a>
  </div>
</div>

<script>
(function(){
  const inp=document.getElementById('gsi'), box=document.getElementById('gsr');
  if(!inp) return;
  let timer;
  const C={'Resource':['#fdf2f2','#C0392B'],'In-House':['#f0fdf4','#166534'],'Requirement':['#eff6ff','#1e40af'],'Client':['#faf5ff','#6b21a8'],'Vendor':['#fff7ed','#9a3412'],'Lead':['#fefce8','#854d0e']};
  function badge(t){const c=C[t]||['#f3f4f6','#374151'];return `<span style="background:${c[0]};color:${c[1]};font-size:.68rem;font-weight:600;padding:2px 8px;border-radius:20px;margin-right:8px;border:1px solid ${c[0]}">${t}</span>`;}
  async function search(q){
    if(!q||q.length<2){box.classList.add('d-none');return;}
    try{
      const res=await fetch('/api/search?q='+encodeURIComponent(q));
      const data=await res.json();
      box.innerHTML=data.length?data.map(r=>`<a href="${r.url}" class="crm-si" style="display:flex;align-items:flex-start;padding:.6rem 1rem;text-decoration:none;border-bottom:1px solid #f3f4f6"><div>${badge(r.type)}<span style="font-weight:500;font-size:.83rem;color:#1A1A1A">${r.label}</span>${r.sublabel?`<div style="font-size:.74rem;color:#6B7280">${r.sublabel}</div>`:''}</div></a>`).join(''):'<div style="padding:.9rem;color:#6B7280;font-size:.82rem">No results found.</div>';
      box.classList.remove('d-none');
    }catch(e){box.classList.add('d-none');}
  }
  inp.addEventListener('input',e=>{clearTimeout(timer);timer=setTimeout(()=>search(e.target.value.trim()),220);});
  document.addEventListener('click',e=>{if(!inp.contains(e.target)&&!box.contains(e.target))box.classList.add('d-none');});
  inp.addEventListener('focus',()=>{if(inp.value.trim().length>=2)search(inp.value.trim());});
})();
</script>
<style>.crm-si:hover{background:#fdf2f2!important;}.crm-si:last-child{border-bottom:none!important;}</style>
