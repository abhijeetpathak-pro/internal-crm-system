<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head',{title:'Vendors — CWA CRM'}) %>
</head>
<body>
  <%- include('../partials/sidebar',{user,active}) %>
  <div class="main-content">
    <%- include('../partials/topbar',{user}) %>
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-semibold mb-0"><i class="fa-solid fa-handshake me-2 text-danger"></i>Vendors</h4>
      <% if(user.role==='admin'||user.role==='super_admin'){ %>
      <a href="/vendors/add" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>Add Vendor</a>
      <% } %>
    </div>
    <div class="card stat-card p-0">
      <table class="table align-middle mb-0">
        <thead>
          <tr class="text-secondary small text-uppercase border-bottom">
            <th class="ps-3">Vendor</th>
            <th>Code</th>
            <th>Website</th>
            <th>Phone</th>
            <th class="pe-3"></th>
          </tr>
        </thead>
        <tbody>
          <% vendors.forEach(function(v){ %>
          <tr id="vrow-<%= v.id %>">
            <td class="ps-3 fw-semibold"><%= v.vendor_name %></td>
            <td><span class="badge bg-light text-dark border"><%= v.short_code %></span></td>
            <td class="small"><% if(v.website){ %><a href="<%= v.website %>" target="_blank" class="text-decoration-none" style="color:#C0392B"><%= v.website.replace(/^https?:\/\//,'').split('/')[0] %></a><% }else{ %>—<% } %></td>
            <td class="small text-secondary"><%= v.phone||'—' %></td>
            <td class="pe-3 text-end">
              <div class="dropdown">
                <button class="btn btn-sm btn-light border rounded-circle" style="width:32px;height:32px;padding:0" data-bs-toggle="dropdown">
                  <i class="fa-solid fa-ellipsis-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                  <li><a class="dropdown-item" href="/vendors/<%= v.id %>"><i class="fa-solid fa-eye me-2 text-secondary"></i>View & POCs</a></li>
                  <% if(user.role==='admin'||user.role==='super_admin'){ %>
                  <li><a class="dropdown-item" href="#" onclick="editVendor('<%= v.id %>', '<%= v.vendor_name %>', '<%= v.short_code %>', '<%= v.website %>', '<%= v.phone %>', '<%= v.email %>', '<%= v.address %>');return false"><i class="fa-solid fa-pencil me-2 text-primary"></i>Edit</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-danger" href="#" onclick="delVendor('<%= v.id %>');return false"><i class="fa-solid fa-trash me-2"></i>Delete</a></li>
                  <% } %>
                </ul>
              </div>
            </td>
          </tr>
          <% }) %>
          <% if(!vendors.length){ %><tr><td colspan="5" class="text-center py-4 text-secondary">No vendors yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Edit Vendor Modal -->
  <div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-0">
          <h5 class="modal-title fw-semibold">Edit Vendor</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="eId">
          <div class="row g-2">
            <div class="col-md-8"><label class="form-label small">Vendor Name</label><input type="text" id="eName" class="form-control form-control-sm"></div>
            <div class="col-md-4"><label class="form-label small">Short Code</label><input type="text" id="eCode" class="form-control form-control-sm" maxlength="10"></div>
            <div class="col-md-6"><label class="form-label small">Website</label><input type="url" id="eWeb" class="form-control form-control-sm"></div>
            <div class="col-md-6"><label class="form-label small">Phone</label><input type="text" id="ePhone" class="form-control form-control-sm"></div>
            <div class="col-12"><label class="form-label small">Email</label><input type="email" id="eEmail" class="form-control form-control-sm"></div>
            <div class="col-12"><label class="form-label small">Address</label><textarea id="eAddr" class="form-control form-control-sm" rows="2"></textarea></div>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-primary btn-sm" onclick="submitEdit()">Save</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
  <script>
    // Fix dropdowns
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.dropdown-toggle').forEach(function(el) {
        new bootstrap.Dropdown(el);
      });
    });

    const editModal = new bootstrap.Modal(document.getElementById('editModal'));

    // EDIT FUNCTION - receives individual parameters (not JSON)
    function editVendor(id, name, code, website, phone, email, address) {
      document.getElementById('eId').value = id;
      document.getElementById('eName').value = name || '';
      document.getElementById('eCode').value = code || '';
      document.getElementById('eWeb').value = website || '';
      document.getElementById('ePhone').value = phone || '';
      document.getElementById('eEmail').value = email || '';
      document.getElementById('eAddr').value = address || '';
      editModal.show();
    }

    async function submitEdit() {
      const id = document.getElementById('eId').value;
      const res = await fetch('/api/vendors/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          vendor_name: document.getElementById('eName').value,
          short_code: document.getElementById('eCode').value,
          website: document.getElementById('eWeb').value,
          phone: document.getElementById('ePhone').value,
          email: document.getElementById('eEmail').value,
          address: document.getElementById('eAddr').value
        })
      });
      if (res.ok) {
        location.reload();
      } else {
        alert('Failed to update.');
      }
    }

    async function delVendor(id) {
      if (!confirm('Delete this vendor?')) return;
      const res = await fetch('/api/vendors/' + id, { method: 'DELETE' });
      if (res.ok) {
        document.getElementById('vrow-' + id)?.remove();
      } else {
        alert('Failed to delete.');
      }
    }
  </script>
</body>
</html>