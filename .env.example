# Required in every environment
SESSION_SECRET=replace-with-at-least-32-random-characters

# Application
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=crm_app
DB_PASS=replace-with-a-strong-password
DB_NAME=crm_db


# Optional AI-assisted CRM features
# Use an OpenAI-compatible provider. Keep the real key only in the server environment.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-5-mini

# Optional task reminder email job
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=http://localhost:3000
